---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Emberio</title>
	</head>
	<body>
		<h1>Emberio</h1>
		<button id="check-obs">Probar libobs</button>
		<p id="obs-version"></p>
		<button id="init-obs">Inicializar libobs (video+audio+modulos)</button>
		<p id="obs-init-status"></p>
		<button id="start-capture">Armar captura (monitor + audio)</button>
		<p id="start-capture-status"></p>
		<script>
			import { invoke } from "@tauri-apps/api/core";

			document.getElementById("check-obs")?.addEventListener("click", async () => {
				const el = document.getElementById("obs-version")!;
				try {
					const version = await invoke<string>("get_obs_version");
					el.textContent = `libobs version: ${version}`;
				} catch (err) {
					el.textContent = `Error: ${err}`;
				}
			});

			document.getElementById("init-obs")?.addEventListener("click", async () => {
				const el = document.getElementById("obs-init-status")!;
				el.textContent = "Inicializando...";
				try {
					const status = await invoke<string>("obs_init");
					el.textContent = status;
				} catch (err) {
					el.textContent = `Error: ${err}`;
				}
			});

			document.getElementById("start-capture")?.addEventListener("click", async () => {
				const el = document.getElementById("start-capture-status")!;
				el.textContent = "Armando captura...";
				try {
					const status = await invoke<string>("obs_start_capture");
					el.textContent = status;
				} catch (err) {
					el.textContent = `Error: ${err}`;
				}
			});
		</script>
	</body>
</html>
