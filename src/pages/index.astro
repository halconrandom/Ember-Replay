---
import '../styles/global.css';
---

<html lang="es" class="h-full">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Ember</title>
	</head>
	<body class="h-full m-0 overflow-hidden select-none font-sans text-zinc-300 antialiased bg-[#09090b]">
		<div class="w-screen h-screen flex flex-col overflow-hidden">
			<!-- Titlebar propia (ventana sin bordes nativos) -->
			<div
				data-tauri-drag-region
				id="app-titlebar"
				class="h-8 bg-[#060608] border-b border-zinc-900/80 flex items-center justify-between px-4 shrink-0 select-none cursor-default"
			>
				<div class="flex items-center gap-2 pointer-events-none">
					<img src="/logo.svg" alt="" width="16" height="16" class="rounded-sm" />
					<span class="font-semibold text-zinc-200 text-xs tracking-wide">Ember <span class="text-zinc-600 font-normal">| Studio Capture</span></span>
				</div>
				<div class="flex items-center gap-4 text-zinc-500">
					<button id="win-minimize" aria-label="Minimizar" class="hover:text-zinc-300 cursor-pointer transition-colors leading-none">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/></svg>
					</button>
					<button id="win-maximize" aria-label="Maximizar" class="hover:text-zinc-300 cursor-pointer transition-colors leading-none">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="1"/></svg>
					</button>
					<button id="win-close" aria-label="Cerrar" class="hover:text-red-400 cursor-pointer transition-colors leading-none">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
					</button>
				</div>
			</div>

			<!-- Tab Switcher Bar -->
			<div class="h-10 bg-[#0c0c0e] border-b border-zinc-800/80 flex items-center justify-between px-5 shrink-0 select-none">
				<div class="flex items-center gap-1 bg-[#18181b] p-0.5 rounded-lg border border-zinc-800">
					<button id="tab-studio" class="px-4 py-0.5 text-xs font-semibold rounded-md transition-all duration-200 cursor-pointer bg-[#e05a10] text-white">Estudio</button>
					<button id="tab-settings" class="px-4 py-0.5 text-xs font-medium rounded-md transition-all duration-200 text-zinc-400 hover:text-zinc-200 cursor-pointer">Configuración</button>
				</div>
				<div class="flex items-center gap-4">
					<div class="flex items-center gap-2">
						<span id="status-dot" class="w-2 h-2 rounded-full bg-zinc-600"></span>
						<span id="status-label" class="text-[10px] font-bold tracking-widest uppercase text-zinc-500">Ready</span>
					</div>
					<span id="elapsed-timer" class="font-mono text-sm text-zinc-400">00:00:00</span>
				</div>
			</div>

			<!-- Viewport Container -->
			<div class="flex-1 overflow-hidden relative bg-[#09090b]">
				<!-- Pestaña 1: Estudio -->
				<div id="content-studio" class="absolute inset-0 flex gap-3 p-3 overflow-hidden">
					<!-- Columna Izquierda: Preview y Fuentes -->
					<div class="flex-1 flex flex-col gap-2 overflow-hidden">
						<!-- Panel Preview -->
						<div class="bg-[#121215] border border-zinc-800/80 rounded-xl p-2.5 flex flex-col items-center justify-center shrink-0">
							<div id="preview-surface" class="w-[440px] h-[248px] bg-black rounded-lg border border-zinc-900 flex items-center justify-center overflow-hidden shrink-0 relative">
								<span id="preview-placeholder" class="text-[11px] text-zinc-600 px-6 text-center select-none">Preview apagado -- actívalo para ver la transmisión</span>
								
								<!-- Resize Handle -->
								<div id="preview-resizer" class="absolute bottom-1 right-1 w-3.5 h-3.5 cursor-se-resize flex items-center justify-center text-zinc-600 hover:text-zinc-300 select-none z-10">
									<svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M22 22H2v-4h16V2h4v20z"/></svg>
								</div>
							</div>
							
							<!-- Toolbar de control del Preview -->
							<div id="preview-toolbar" class="w-[440px] flex items-center justify-between mt-2 px-1 select-none shrink-0">
								<div class="flex items-center gap-2">
									<button id="toggle-preview" class="text-xs font-medium text-orange-400 bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/30 rounded px-3 py-0.5 transition-all cursor-pointer">
										Activar preview
									</button>
									<div class="flex items-center gap-1.5 bg-zinc-900 px-2 py-0.5 rounded border border-zinc-800">
										<span class="text-[10px] text-zinc-500 uppercase tracking-wide">Zoom:</span>
										<span id="zoom-display" class="text-xs text-zinc-300 font-mono min-w-[32px] text-center">100%</span>
										<button id="reset-zoom" class="text-[9px] text-zinc-400 hover:text-zinc-200 bg-zinc-800 px-1.5 py-0.2 rounded border border-zinc-700 font-medium">Reset</button>
									</div>
								</div>
								
								<div class="flex items-center gap-2 bg-zinc-900 px-2 py-0.5 rounded border border-zinc-800">
									<label for="grid-select" class="text-[10px] text-zinc-500 uppercase tracking-wide">Cuadrícula:</label>
									<select id="grid-select" class="bg-transparent border-none text-zinc-300 text-xs focus:outline-none cursor-pointer">
										<option value="none">Ninguna</option>
										<option value="thirds">Tercios</option>
										<option value="grid10">Grid 10x10</option>
										<option value="grid20">Grid 20x20</option>
									</select>
								</div>
							</div>
						</div>

						<!-- Panel Fuentes / Capas -->
						<div class="flex-1 bg-[#121215] border border-zinc-800/80 rounded-xl p-3 flex flex-col overflow-hidden">
							<div class="flex items-center justify-between border-b border-zinc-800/50 pb-2 mb-2 shrink-0">
								<div class="flex items-center gap-2">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-orange-500"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
									<h3 class="text-xs font-bold uppercase tracking-wider text-zinc-300">Fuentes / Capas</h3>
								</div>
								<div class="flex gap-1.5">
									<button id="add-image-overlay" class="flex items-center gap-1 text-[10px] font-semibold text-zinc-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 px-2 py-1 rounded border border-zinc-700 transition-colors cursor-pointer">
										+ Imagen
									</button>
									<button id="show-add-text-overlay" class="flex items-center gap-1 text-[10px] font-semibold text-zinc-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 px-2 py-1 rounded border border-zinc-700 transition-colors cursor-pointer">
										+ Texto
									</button>
								</div>
							</div>
							
							<div id="add-text-overlay-form" class="hidden items-center gap-2 bg-[#09090b] border border-zinc-800 rounded-lg p-2 mb-2 shrink-0">
								<input type="text" id="new-overlay-text" placeholder="Texto del overlay" class="flex-1 min-w-0 bg-zinc-900 border border-zinc-700 text-zinc-200 text-xs rounded px-2 py-1 focus:outline-none" />
								<button id="confirm-add-text-overlay" class="shrink-0 text-[10px] font-semibold bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/30 text-orange-400 px-3 py-1 rounded transition-colors cursor-pointer">Agregar</button>
							</div>
							<p id="overlays-status" class="text-[9px] text-zinc-500 mb-1 shrink-0"></p>

							<div id="overlays-list" class="flex-1 overflow-y-auto space-y-1.5 pr-1"></div>
						</div>
					</div>

					<!-- Columna Derecha: Grabación y Mixer -->
					<div class="w-[360px] flex flex-col gap-2 overflow-hidden shrink-0">
						<!-- Panel Controles de Grabación -->
						<div class="bg-[#121215] border border-zinc-800/80 rounded-xl p-3 flex flex-col gap-2 shrink-0">
							<div class="flex items-center gap-2 border-b border-zinc-800/50 pb-2">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-orange-500"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/></svg>
								<h3 class="text-xs font-bold uppercase tracking-wider text-zinc-300">Controles de Captura</h3>
							</div>

							<div class="flex flex-col gap-2">
								<button id="record-toggle" class="w-full py-2 rounded-lg flex items-center justify-center gap-2.5 font-semibold text-sm transition-all duration-300 border bg-gradient-to-b from-zinc-800 to-zinc-900 border-zinc-700 hover:border-zinc-500 hover:text-white cursor-pointer select-none">
									<div id="record-btn-dot" class="w-2.5 h-2.5 rounded-full bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.5)]"></div>
									<span id="record-label">Iniciar Grabación</span>
								</button>
								<div class="hidden" id="record-icon-idle"></div>
								<div class="hidden" id="record-icon-active"></div>
							</div>

							<div class="h-px bg-zinc-800/50"></div>

							<div class="flex items-center justify-between text-xs">
								<span class="text-zinc-400">Duración del clip:</span>
								<div class="flex items-center gap-1 font-mono text-zinc-300 bg-zinc-900 px-2 py-0.5 rounded border border-zinc-800">
									<input type="number" id="clip-seconds" value="60" min="5" max="1200" class="w-8 bg-transparent text-center focus:outline-none" aria-label="Segundos a clipear" />
									<span class="text-zinc-500">s</span>
								</div>
							</div>

							<button id="save-clip" class="w-full py-1.5 bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/20 hover:border-orange-500/40 rounded-lg text-xs font-semibold text-orange-400 flex items-center justify-center gap-2 transition-all cursor-pointer">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
								Guardar Clip (F9)
							</button>

							<p id="save-clip-status" class="text-center text-[10px] text-zinc-500 font-mono min-h-[1.4em] break-words px-1 bg-zinc-950/40 rounded py-0.5 border border-zinc-900/50"></p>
							<div class="hidden"><span id="hotkey-label"></span></div>
						</div>

						<!-- Panel Mezclador de Audio -->
						<div class="flex-1 bg-[#121215] border border-zinc-800/80 rounded-xl p-3 flex flex-col overflow-hidden">
							<div class="flex items-center justify-between border-b border-zinc-800/50 pb-2 mb-2 shrink-0">
								<div class="flex items-center gap-2">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-orange-500"><path d="M12 2v20M17 5v14M22 9v6M7 8v8M2 10v4"/></svg>
									<h3 class="text-xs font-bold uppercase tracking-wider text-zinc-300">Mezclador de Audio</h3>
								</div>
								<button id="show-add-track" class="text-[10px] font-semibold text-zinc-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 px-2 py-0.5 rounded border border-zinc-700 transition-colors cursor-pointer">
									+ Pista
								</button>
							</div>

							<div id="add-track-form" class="hidden items-center gap-2 bg-[#09090b] border border-zinc-800 rounded-lg p-2 mb-2 shrink-0">
								<select id="new-audio-kind" class="bg-zinc-900 border border-zinc-700 text-zinc-300 text-[10px] rounded px-1.5 py-1 focus:outline-none">
									<option value="output">Salida</option>
									<option value="input">Entrada</option>
								</select>
								<select id="new-audio-device" class="flex-1 min-w-0 bg-zinc-900 border border-zinc-700 text-zinc-300 text-[10px] rounded px-1.5 py-1 focus:outline-none truncate"></select>
								<button id="confirm-add-track" class="shrink-0 text-[10px] font-semibold bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/30 text-orange-400 px-2.5 py-1 rounded cursor-pointer transition-colors">OK</button>
							</div>
							<p id="audio-sources-status" class="text-[9px] text-zinc-500 mb-1 shrink-0"></p>

							<div id="audio-tracks" class="flex-1 flex gap-2 overflow-x-auto items-stretch py-0.5 pr-1"></div>
						</div>
					</div>
				</div>

				<!-- Pestaña 2: Configuración -->
				<div id="content-settings" class="absolute inset-0 hidden flex gap-4 p-4 overflow-hidden">
					<!-- Columna Izquierda: Video -->
					<div class="flex-1 bg-[#121215] border border-zinc-800/80 rounded-xl p-5 flex flex-col gap-4 overflow-y-auto">
						<div class="flex items-center gap-2 border-b border-zinc-800/50 pb-2.5 mb-2">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-orange-500"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
							<h3 class="text-xs font-bold uppercase tracking-wider text-zinc-300">Origen y Ajustes de Video</h3>
						</div>

						<div class="flex flex-col gap-4">
							<div class="grid grid-cols-2 gap-4">
								<div>
									<label for="capture-type-select" class="text-[10px] text-zinc-500 uppercase tracking-wider font-semibold mb-1.5 block">Tipo de Captura</label>
									<select id="capture-type-select" class="w-full bg-[#09090b] border border-zinc-700/80 text-zinc-300 text-xs rounded-md px-3 py-2 focus:outline-none focus:border-orange-500/50 transition-colors">
										<option value="screen">Pantalla Completa</option>
										<option value="window">Ventana Específica</option>
										<option value="game">Captura de Juego (Hook)</option>
									</select>
								</div>
								<div>
									<label for="source-select" class="text-[10px] text-zinc-500 uppercase tracking-wider font-semibold mb-1.5 block">Origen de Captura</label>
									<select id="source-select" class="w-full bg-[#09090b] border border-zinc-700/80 text-zinc-200 text-xs rounded-md px-3 py-2 focus:outline-none focus:border-orange-500/50 transition-colors font-medium truncate"></select>
									<div class="hidden"><select id="monitor-select"></select></div>
								</div>
							</div>

							<div class="grid grid-cols-2 gap-4">
								<div>
									<label for="resolution-select" class="text-[10px] text-zinc-500 uppercase tracking-wider font-semibold mb-1.5 block">Resolución de Grabación</label>
									<select id="resolution-select" class="w-full bg-[#09090b] border border-zinc-700/80 text-zinc-300 text-xs rounded-md px-3 py-2 focus:outline-none focus:border-orange-500/50 transition-colors">
										<option value="original">Original</option>
										<option value="720p">720p (Escalado)</option>
									</select>
								</div>
								<div>
									<label for="fps-select" class="text-[10px] text-zinc-500 uppercase tracking-wider font-semibold mb-1.5 block">Cuadros por Segundo (FPS)</label>
									<select id="fps-select" class="w-full bg-[#09090b] border border-zinc-700/80 text-zinc-300 text-xs rounded-md px-3 py-2 focus:outline-none focus:border-orange-500/50 transition-colors">
										<option value="60">60 FPS</option>
										<option value="30">30 FPS</option>
									</select>
								</div>
							</div>
							
							<div class="bg-zinc-950/40 p-3 rounded-lg border border-zinc-900 text-[10px] text-zinc-500 font-medium">
								* Nota: Los cambios de tipo y origen de captura se aplican inmediatamente. Los ajustes de FPS y resolución se aplicarán la próxima vez que inicies una grabación.
							</div>
						</div>
					</div>

					<!-- Columna Derecha: Almacenamiento y Atajos -->
					<div class="w-[320px] bg-[#121215] border border-zinc-800/80 rounded-xl p-5 flex flex-col gap-4 overflow-y-auto shrink-0">
						<div class="flex items-center gap-2 border-b border-zinc-800/50 pb-2.5 mb-2">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-orange-500"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
							<h3 class="text-xs font-bold uppercase tracking-wider text-zinc-300">Rutas y Atajos</h3>
						</div>

						<div class="flex flex-col gap-4">
							<div>
								<div class="flex items-center justify-between mb-1.5">
									<label class="text-[10px] text-zinc-500 uppercase tracking-wider font-semibold">Destino de Clips</label>
									<button id="pick-clips-dir" class="text-[10px] text-orange-400 hover:text-orange-300 font-semibold cursor-pointer">Cambiar</button>
								</div>
								<div id="clips-dir-display" class="w-full bg-[#09090b] border border-zinc-700/80 text-zinc-400 text-xs rounded-md px-3 py-2.5 font-mono truncate cursor-pointer hover:border-zinc-600 transition-colors">
									clips/ (por defecto)
								</div>
							</div>

							<div>
								<label class="text-[10px] text-zinc-500 uppercase tracking-wider font-semibold mb-1.5 block">Atajo de Teclado (Hotkey)</label>
								<button id="change-hotkey" class="w-full flex items-center justify-between bg-[#09090b] border border-zinc-700/80 rounded-md px-3 py-2.5 hover:border-orange-500/50 transition-colors cursor-pointer">
									<span class="text-xs text-zinc-400">Guardar clip</span>
									<kbd id="hotkey-kbd" class="bg-zinc-800 text-zinc-200 px-2 py-0.5 rounded text-[10px] border border-zinc-700 font-mono">F9</kbd>
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Status Bar Footer -->
			<div class="h-5 bg-[#060608] border-t border-zinc-900 flex items-center justify-between px-4 text-[10px] text-zinc-650 shrink-0 select-none">
				<span>Ember v0.1.0</span>
				<span>Developed by halcon.dev</span>
			</div>
		</div>

		<template id="audio-track-template">
			<div class="audio-track flex flex-col items-center justify-between bg-[#18181b]/95 border border-zinc-800/85 p-1.5 rounded-xl group hover:border-zinc-700/85 transition-colors w-[84px] shrink-0 h-full relative select-none">
				<!-- Mute & Remove icons on top corners -->
				<div class="w-full flex justify-between px-1 shrink-0 mb-0.5">
					<button class="track-mute text-zinc-500 hover:text-zinc-200 transition-colors cursor-pointer" aria-label="Silenciar">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
					</button>
					<button class="track-remove text-zinc-650 hover:text-red-400 transition-colors cursor-pointer" aria-label="Quitar">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
					</button>
				</div>

				<!-- Track Labels -->
				<div class="w-full text-center shrink-0 min-h-[26px] px-1 mb-1">
					<div class="track-label text-[9px] text-zinc-250 font-bold truncate cursor-pointer hover:text-orange-400 select-all" title="Doble clic para renombrar"></div>
					<div class="track-kind text-[7px] text-zinc-550 uppercase font-semibold mt-0.5"></div>
				</div>

				<!-- Vertical Sliders & Level Meter -->
				<div class="flex-1 flex items-center justify-center gap-1.5 mb-1 w-full px-2">
					<!-- VU Level Meter (Vertical) -->
					<div class="w-1 h-full bg-zinc-900 rounded-sm overflow-hidden flex flex-col justify-end border border-zinc-850">
						<div class="track-level w-full bg-orange-500 transition-[height] duration-75" style="height:0%"></div>
					</div>
					<!-- Volume Slider (Vertical) -->
					<div class="h-full flex items-center flex-1 justify-center">
						<input type="range" min="0" max="200" value="100" class="track-volume h-full w-1 bg-zinc-900 rounded-lg appearance-none cursor-pointer accent-orange-500 [writing-mode:vertical-lr] [direction:rtl] border border-zinc-850" />
					</div>
				</div>

				<!-- Volume decibel label/input -->
				<input type="text" class="track-volume-db w-16 bg-zinc-900/60 border border-zinc-800 hover:border-zinc-700 focus:border-orange-500/50 text-zinc-300 text-[8px] font-mono rounded text-center focus:outline-none shrink-0" title="Volumen en dB (presiona Enter para guardar)" />
			</div>
		</template>

		<template id="overlay-template">
			<div class="overlay-item flex items-center gap-1.5 bg-[#09090b]/80 border border-zinc-800/80 p-1.5 rounded-lg group hover:border-zinc-700/80 transition-colors">
				<!-- Order buttons -->
				<div class="flex flex-col gap-0.5 shrink-0">
					<button class="overlay-move-up text-zinc-500 hover:text-zinc-200 text-[8px] leading-none transition-colors cursor-pointer select-none">▲</button>
					<button class="overlay-move-down text-zinc-500 hover:text-zinc-200 text-[8px] leading-none transition-colors cursor-pointer select-none">▼</button>
				</div>
				
				<span class="overlay-kind-badge shrink-0 text-[8px] font-bold uppercase px-1 py-0.5 rounded bg-zinc-800 text-zinc-400"></span>
				<span class="overlay-content flex-1 min-w-0 text-[11px] text-zinc-300 truncate" title=""></span>
				
				<input type="number" class="overlay-x w-11 bg-zinc-900 border border-zinc-700/60 text-zinc-300 text-[10px] rounded px-1 py-0.5 text-center focus:outline-none shrink-0" title="Posicion X" />
				<input type="number" class="overlay-y w-11 bg-zinc-900 border border-zinc-700/60 text-zinc-300 text-[10px] rounded px-1 py-0.5 text-center focus:outline-none shrink-0" title="Posicion Y" />
				<input type="number" step="0.1" min="0.1" max="5" class="overlay-scale w-12 bg-zinc-900 border border-zinc-700/60 text-zinc-300 text-[10px] rounded px-1 py-0.5 text-center focus:outline-none shrink-0" title="Escala" />
				
				<button class="overlay-toggle-lock text-zinc-500 hover:text-zinc-200 transition-colors shrink-0 cursor-pointer" aria-label="Bloquear/desbloquear">
					<!-- Candado se inyecta dinamicamente -->
				</button>
				<button class="overlay-toggle-visible text-zinc-500 hover:text-zinc-200 transition-colors shrink-0 cursor-pointer" aria-label="Mostrar/ocultar">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
				</button>
				<button class="overlay-remove text-zinc-650 hover:text-red-400 transition-colors shrink-0 cursor-pointer" aria-label="Quitar">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
				</button>
			</div>
		</template>

		<script>
			import { invoke } from "@tauri-apps/api/core";
			import { listen } from "@tauri-apps/api/event";
			import { open } from "@tauri-apps/plugin-dialog";
			import { getCurrentWindow } from "@tauri-apps/api/window";

			// ---------------------------------------------------------------
			// Tipos
			// ---------------------------------------------------------------
			interface HotkeyConfig {
				vk_code: number;
				ctrl: boolean;
				shift: boolean;
				alt: boolean;
			}
			interface AudioSourceConfig {
				kind: "output" | "input";
				device_id: string;
				label: string;
				volume: number;
				muted: boolean;
			}
			interface OverlayInfo {
				index: number;
				kind: "image" | "text";
				content: string;
				x: number;
				y: number;
				scale: number;
				visible: boolean;
				locked: boolean;
			}
			interface EmberioConfig {
				clip_seconds: number;
				clips_dir: string | null;
				hotkey: HotkeyConfig | null;
				video_source_type: string;
				video_source_id: string | null;
				monitor_id: string | null;
				audio_sources: AudioSourceConfig[];
				theme: string;
				resolution: string;
				fps: number;
			}
			interface PropertyOption {
				name: string;
				value: string;
			}

			function el<T extends HTMLElement = HTMLElement>(id: string): T | null {
				return document.getElementById(id) as T | null;
			}
			function setText(id: string, text: string) {
				const e = el(id);
				if (e) e.textContent = text;
			}

			// ---------------------------------------------------------------
			// Titlebar propia
			// ---------------------------------------------------------------
			const win = getCurrentWindow();
			el("win-minimize")?.addEventListener("click", () => win.minimize());
			el("win-maximize")?.addEventListener("click", () => win.toggleMaximize());
			el("win-close")?.addEventListener("click", () => win.close());

			// ---------------------------------------------------------------
			// Arrastre de ventana maximizada (Drag region fix)
			// ---------------------------------------------------------------
			const titlebar = el("app-titlebar")!;
			let isMouseDown = false;

			titlebar.addEventListener("mousedown", (e) => {
				if ((e.target as HTMLElement).closest("button") || (e.target as HTMLElement).closest("a")) return;
				isMouseDown = true;
			});

			window.addEventListener("mouseup", () => {
				isMouseDown = false;
			});

			titlebar.addEventListener("mousemove", async () => {
				if (isMouseDown) {
					const isMax = await win.isMaximized();
					if (isMax) {
						isMouseDown = false;
						await win.unmaximize();
						await win.startDragging();
					}
				}
			});

			// Doble clic para maximizar/restaurar
			titlebar.addEventListener("dblclick", async (e) => {
				if ((e.target as HTMLElement).closest("button") || (e.target as HTMLElement).closest("a")) return;
				await win.toggleMaximize();
			});

			// ---------------------------------------------------------------
			// Redimensionar Preview (Resize handle)
			// ---------------------------------------------------------------
			const previewSurface = el("preview-surface")!;
			const resizeHandle = el("preview-resizer")!;
			let isResizing = false;
			let startX = 0;
			let startWidth = 0;

			resizeHandle.addEventListener("mousedown", (e) => {
				e.stopPropagation();
				e.preventDefault();
				isResizing = true;
				startX = e.clientX;
				startWidth = previewSurface.offsetWidth;
			});

			window.addEventListener("mouseup", () => {
				if (isResizing) {
					isResizing = false;
				}
			});

			window.addEventListener("mousemove", (e) => {
				if (isResizing) {
					const dx = e.clientX - startX;
					let newWidth = startWidth + dx;
					
					// Calcular límites dinámicos basándose en el tamaño de la ventana y el alto disponible
					const leftCol = previewSurface.closest(".flex-col") as HTMLElement;
					const leftColHeight = leftCol ? leftCol.offsetHeight : 400;
					
					// El panel de capas necesita al menos 80px de altura disponible
					const maxPreviewPanelHeight = leftColHeight - 80;
					// El panel de preview ocupa: alto_surface + 32px (toolbar) + 16px (padding/margins) = surface_height + 48px
					const maxSurfaceHeight = maxPreviewPanelHeight - 48;
					const maxWBasedOnHeight = Math.floor(maxSurfaceHeight * 16 / 9);
					
					// Asegurar al menos 320px de ancho para el mezclador y la columna derecha
					const maxAllowedWidth = Math.min(window.innerWidth - 340, maxWBasedOnHeight);
					const minAllowedWidth = 240;
					
					if (newWidth < minAllowedWidth) newWidth = minAllowedWidth;
					if (newWidth > maxAllowedWidth) newWidth = maxAllowedWidth;
					
					previewSurface.style.width = `${newWidth}px`;
					previewSurface.style.height = `${Math.round(newWidth * 9 / 16)}px`;
					
					// Ajustar toolbar
					const previewToolbar = el("preview-toolbar")!;
					if (previewToolbar) {
						previewToolbar.style.width = `${newWidth}px`;
					}
					
					// Actualizar coordenadas nativas
					refreshPreviewRectIfEnabled();
				}
			});

			// ---------------------------------------------------------------
			// Control de Pestañas
			// ---------------------------------------------------------------
			let activeTab = "studio"; // "studio" o "settings"

			function updateTab(tab: string) {
				activeTab = tab;
				const btnStudio = el("tab-studio")!;
				const btnSettings = el("tab-settings")!;
				const contentStudio = el("content-studio")!;
				const contentSettings = el("content-settings")!;

				if (tab === "studio") {
					btnStudio.className = "px-4 py-0.5 text-xs font-semibold rounded-md transition-all duration-200 cursor-pointer bg-[#e05a10] text-white";
					btnSettings.className = "px-4 py-0.5 text-xs font-medium rounded-md transition-all duration-200 text-zinc-400 hover:text-zinc-200 cursor-pointer";
					contentStudio.classList.remove("hidden");
					contentSettings.classList.add("hidden");

					// Reactivar preview si el usuario lo tenía encendido
					if (previewEnabledWanted) {
						setPreviewEnabled(true);
					}
				} else {
					btnStudio.className = "px-4 py-0.5 text-xs font-medium rounded-md transition-all duration-200 text-zinc-400 hover:text-zinc-200 cursor-pointer";
					btnSettings.className = "px-4 py-0.5 text-xs font-semibold rounded-md transition-all duration-200 cursor-pointer bg-[#e05a10] text-white";
					contentStudio.classList.add("hidden");
					contentSettings.classList.remove("hidden");

					// Ocultar preview temporalmente mientras se editan configuraciones
					if (previewEnabled) {
						invoke("toggle_preview", { enabled: false, x: 0, y: 0, width: 0, height: 0 })
							.then(() => {
								previewEnabled = false;
								const placeholder = el("preview-placeholder")!;
								placeholder.classList.remove("hidden");
							});
					}
				}
			}

			el("tab-studio")?.addEventListener("click", () => updateTab("studio"));
			el("tab-settings")?.addEventListener("click", () => updateTab("settings"));

			// ---------------------------------------------------------------
			// Grabacion: boton unico que alterna, timer real
			// ---------------------------------------------------------------
			let isRecording = false;
			let timerInterval: number | undefined;

			function formatElapsed(ms: number): string {
				const totalSeconds = Math.floor(ms / 1000);
				const h = String(Math.floor(totalSeconds / 3600)).padStart(2, "0");
				const m = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, "0");
				const s = String(totalSeconds % 60).padStart(2, "0");
				return `${h}:${m}:${s}`;
			}

			function setRecordingUi(recording: boolean) {
				isRecording = recording;
				const dot = el("status-dot")!;
				const label = el("status-label")!;
				const recordLabel = el("record-label")!;
				const btnDot = el("record-btn-dot")!;

				if (recording) {
					dot.className = "w-2 h-2 rounded-full bg-red-500 animate-pulse shadow-[0_0_8px_rgba(239,68,68,0.8)]";
					label.className = "text-[10px] font-bold tracking-widest uppercase text-red-400";
					label.textContent = "Live";
					
					recordLabel.textContent = "Detener Grabación";
					btnDot.className = "w-2.5 h-2.5 rounded-sm bg-red-500 animate-pulse shadow-[0_0_8px_rgba(239,68,68,0.8)] transition-all";
					
					const startedAt = Date.now();
					timerInterval = window.setInterval(() => setText("elapsed-timer", formatElapsed(Date.now() - startedAt)), 1000);
				} else {
					dot.className = "w-2 h-2 rounded-full bg-zinc-600";
					label.className = "text-[10px] font-bold tracking-widest uppercase text-zinc-500";
					label.textContent = "Ready";
					
					recordLabel.textContent = "Iniciar Grabación";
					btnDot.className = "w-2.5 h-2.5 rounded-full bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.5)] transition-all";
					
					if (timerInterval) clearInterval(timerInterval);
					setText("elapsed-timer", "00:00:00");
				}
			}

			el("record-toggle")?.addEventListener("click", async () => {
				const btn = el<HTMLButtonElement>("record-toggle")!;
				btn.disabled = true;
				try {
					if (!isRecording) {
						const seconds = Number((el<HTMLInputElement>("clip-seconds"))!.value) || 60;
						await invoke<string>("start_recording", { clipSeconds: seconds });
						setRecordingUi(true);
					} else {
						await invoke<string>("stop_recording");
						setRecordingUi(false);
					}
				} catch (err) {
					setText("save-clip-status", `Error: ${err}`);
				} finally {
					btn.disabled = false;
				}
			});

			el("save-clip")?.addEventListener("click", async () => {
				setText("save-clip-status", "Guardando...");
				await invoke("save_clip_now");
			});

			listen<string>("clip-saved", (event) => {
				setText("save-clip-status", `Guardado: ${event.payload.split(/[\\/]/).pop()}`);
			});
			listen<string>("clip-save-error", (event) => {
				setText("save-clip-status", `Error: ${event.payload}`);
			});
			listen<OverlayInfo[]>("overlays-updated", (event) => {
				renderOverlays(event.payload);
			});

			// ---------------------------------------------------------------
			// Hotkey de guardado
			// ---------------------------------------------------------------
			function describeHotkey(h: HotkeyConfig | null): string {
				if (!h) return "F9";
				return `${h.ctrl ? "Ctrl+" : ""}${h.shift ? "Shift+" : ""}${h.alt ? "Alt+" : ""}vk${h.vk_code}`;
			}

			el("change-hotkey")?.addEventListener("click", () => {
				const kbd = el("hotkey-kbd")!;
				const original = kbd.textContent;
				kbd.textContent = "...";

				const onKeyDown = async (e: KeyboardEvent) => {
					e.preventDefault();
					window.removeEventListener("keydown", onKeyDown, true);
					try {
						await invoke<string>("set_save_hotkey", { vkCode: e.keyCode, ctrl: e.ctrlKey, shift: e.shiftKey, alt: e.altKey });
						const combo = describeHotkey({ vk_code: e.keyCode, ctrl: e.ctrlKey, shift: e.shiftKey, alt: e.altKey });
						kbd.textContent = combo;
					} catch (err) {
						kbd.textContent = original;
						setText("save-clip-status", `Error: ${err}`);
					}
				};
				window.addEventListener("keydown", onKeyDown, true);
			});

			// ---------------------------------------------------------------
			// Carpeta de clips
			// ---------------------------------------------------------------
			el("pick-clips-dir")?.addEventListener("click", async () => {
				const dir = await open({ directory: true, multiple: false, title: "Elegir carpeta para guardar los clips" });
				if (!dir) return;
				try {
					await invoke<string>("set_clips_dir", { dir });
					setText("clips-dir-display", dir);
				} catch (err) {
					setText("save-clip-status", `Error: ${err}`);
				}
			});
			el("clips-dir-display")?.addEventListener("click", () => el("pick-clips-dir")?.click());

			// ---------------------------------------------------------------
			// Pantalla / Origen de Captura (Pantalla, Ventana, Juego)
			// ---------------------------------------------------------------
			async function populateSelect(id: string, options: PropertyOption[], selected: string | null) {
				const select = el<HTMLSelectElement>(id);
				if (!select) return;
				select.innerHTML = "";
				for (const opt of options) {
					const o = document.createElement("option");
					o.value = opt.value;
					o.textContent = opt.name;
					if (selected && opt.value === selected) o.selected = true;
					select.appendChild(o);
				}
			}

			async function updateSourceOptions(type: string, selectedId: string | null) {
				const sourceSelect = el<HTMLSelectElement>("source-select")!;
				sourceSelect.disabled = true;
				try {
					let options: PropertyOption[] = [];
					if (type === "screen") {
						options = await invoke<PropertyOption[]>("list_monitors");
					} else if (type === "window") {
						options = await invoke<PropertyOption[]>("list_windows");
					} else if (type === "game") {
						options = await invoke<PropertyOption[]>("list_games");
					}
					await populateSelect("source-select", options, selectedId);
				} catch (err) {
					console.error("Error al listar orígenes de captura:", err);
				} finally {
					sourceSelect.disabled = false;
				}
			}

			el("capture-type-select")?.addEventListener("change", async (e) => {
				const val = (e.target as HTMLSelectElement).value;
				await updateSourceOptions(val, null);
				
				// Aplicar el primer elemento por defecto al cambiar el tipo
				const sourceSelect = el<HTMLSelectElement>("source-select")!;
				if (sourceSelect.value) {
					await invoke("set_video_source", { sourceType: val, sourceId: sourceSelect.value });
					await refreshPreviewRectIfEnabled();
				}
			});

			el("source-select")?.addEventListener("change", async (e) => {
				const type = el<HTMLSelectElement>("capture-type-select")!.value;
				const id = (e.target as HTMLSelectElement).value;
				await invoke("set_video_source", { sourceType: type, sourceId: id });
				await refreshPreviewRectIfEnabled();
			});

			el("resolution-select")?.addEventListener("change", async (e) => {
				await invoke("set_resolution", { resolution: (e.target as HTMLSelectElement).value });
			});
			el("fps-select")?.addEventListener("change", async (e) => {
				await invoke("set_fps", { fps: Number((e.target as HTMLSelectElement).value) });
			});

			// ---------------------------------------------------------------
			// Mezclador de audio & Conversiones dB
			// ---------------------------------------------------------------
			let audioOutputDevices: PropertyOption[] = [];
			let audioInputDevices: PropertyOption[] = [];

			function linearToDb(val: number): string {
				if (val <= 0.0001) return "-inf dB";
				const db = 20 * Math.log10(val);
				return `${db >= 0 ? "+" : ""}${db.toFixed(1)} dB`;
			}

			function dbToLinear(dbStr: string): number {
				const cleaned = dbStr.toLowerCase().replace("db", "").replace(" ", "").trim();
				if (cleaned === "-inf" || cleaned === "inf" || Number(cleaned) <= -96.0) {
					return 0.0;
				}
				const db = parseFloat(cleaned);
				if (isNaN(db)) return 1.0;
				const clampedDb = Math.max(-96.0, Math.min(6.0, db));
				return Math.pow(10, clampedDb / 20);
			}

			async function refreshNewAudioDeviceOptions() {
				const kind = el<HTMLSelectElement>("new-audio-kind")!.value;
				await populateSelect("new-audio-device", kind === "input" ? audioInputDevices : audioOutputDevices, null);
			}

			el("show-add-track")?.addEventListener("click", async () => {
				const form = el("add-track-form")!;
				const hidden = form.classList.contains("hidden");
				form.classList.toggle("hidden");
				form.classList.toggle("flex", hidden);
				if (hidden) await refreshNewAudioDeviceOptions();
			});
			el("new-audio-kind")?.addEventListener("change", refreshNewAudioDeviceOptions);

			el("confirm-add-track")?.addEventListener("click", async () => {
				const kind = el<HTMLSelectElement>("new-audio-kind")!.value;
				const deviceSelect = el<HTMLSelectElement>("new-audio-device")!;
				const deviceOption = deviceSelect.selectedOptions[0];
				if (!deviceOption) return;
				try {
					const updated = await invoke<AudioSourceConfig[]>("add_audio_source", {
						kind,
						deviceId: deviceOption.value,
						label: deviceOption.textContent ?? deviceOption.value,
					});
					renderAudioTracks(updated);
					setText("audio-sources-status", "");
				} catch (err) {
					setText("audio-sources-status", `Error: ${err}`);
				}
			});

			function renderAudioTracks(sources: AudioSourceConfig[]) {
				const container = el("audio-tracks")!;
				const template = el<HTMLTemplateElement>("audio-track-template")!;
				container.innerHTML = "";

				sources.forEach((source, index) => {
					const node = template.content.cloneNode(true) as DocumentFragment;
					const trackEl = node.querySelector(".audio-track") as HTMLElement;
					trackEl.dataset.index = String(index);

					(node.querySelector(".track-kind") as HTMLElement).textContent = source.kind === "output" ? "Salida" : "Entrada";
					
					const labelEl = node.querySelector(".track-label") as HTMLElement;
					labelEl.textContent = source.label;
					labelEl.addEventListener("click", async () => {
						const newName = prompt("Renombrar pista de audio:", labelEl.textContent ?? "");
						if (newName !== null && newName.trim() !== "") {
							try {
								const updated = await invoke<AudioSourceConfig[]>("set_audio_source_label", { index, label: newName.trim() });
								renderAudioTracks(updated);
							} catch (err) {
								console.error("Error renombrando pista:", err);
							}
						}
					});

					const volumeInput = node.querySelector(".track-volume") as HTMLInputElement;
					const volumeDbInput = node.querySelector(".track-volume-db") as HTMLInputElement;
					
					const linear = source.volume;
					const pct = Math.round(linear * 100);
					volumeInput.value = String(pct);
					volumeDbInput.value = linearToDb(linear);

					volumeInput.addEventListener("input", () => {
						const currentLinear = Number(volumeInput.value) / 100;
						volumeDbInput.value = linearToDb(currentLinear);
					});
					
					volumeInput.addEventListener("change", async () => {
						const currentLinear = Number(volumeInput.value) / 100;
						await invoke<AudioSourceConfig[]>("set_audio_source_volume", { index, volume: currentLinear });
					});

					volumeDbInput.addEventListener("change", async () => {
						const newLinear = dbToLinear(volumeDbInput.value);
						volumeInput.value = String(Math.round(newLinear * 100));
						await invoke<AudioSourceConfig[]>("set_audio_source_volume", { index, volume: newLinear });
						volumeDbInput.value = linearToDb(newLinear);
					});

					const muteBtn = node.querySelector(".track-mute") as HTMLButtonElement;
					function paintMute(muted: boolean) {
						muteBtn.classList.toggle("text-red-405", muted);
						muteBtn.classList.toggle("text-zinc-500", !muted);
						muteBtn.setAttribute("aria-pressed", String(muted));
						
						// Si está silenciado, pintar el icono rojo
						muteBtn.innerHTML = muted 
							? `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-red-500"><line x1="1" y1="1" x2="23" y2="23"/><path d="M9 9v6H5v-6z"/><path d="M16 9a5 5 0 0 1 0 6"/></svg>`
							: `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-zinc-400 hover:text-zinc-200"><path d="M11 5 6 9H2v6h4l5 4z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>`;
					}
					paintMute(source.muted);
					muteBtn.addEventListener("click", async () => {
						const nowMuted = muteBtn.getAttribute("aria-pressed") !== "true";
						await invoke<AudioSourceConfig[]>("set_audio_source_muted", { index, muted: nowMuted });
						paintMute(nowMuted);
					});

					const removeBtn = node.querySelector(".track-remove") as HTMLButtonElement;
					removeBtn.addEventListener("click", async () => {
						const updated = await invoke<AudioSourceConfig[]>("remove_audio_source", { index });
						renderAudioTracks(updated);
					});

					container.appendChild(node);
				});
			}

			// Medidores de nivel en vivo (VU vertical)
			listen<number[]>("audio-levels", (event) => {
				const levels = event.payload;
				document.querySelectorAll<HTMLElement>(".audio-track").forEach((trackEl) => {
					const index = Number(trackEl.dataset.index);
					const level = levels[index] ?? 0;
					const bar = trackEl.querySelector(".track-level") as HTMLElement;
					if (!bar) return;
					bar.style.height = `${Math.round(level * 100)}%`;
					bar.classList.toggle("bg-orange-500", level < 0.85);
					bar.classList.toggle("bg-red-500", level >= 0.85);
				});
			});

			// ---------------------------------------------------------------
			// Preview en vivo, Zoom, Paneo y Cuadrícula (OBS)
			// ---------------------------------------------------------------
			let previewEnabled = false;
			let previewEnabledWanted = false;

			function previewRect() {
				const surface = el("preview-surface")!;
				const rect = surface.getBoundingClientRect();
				const dpr = window.devicePixelRatio || 1;
				return {
					x: Math.round(rect.left * dpr),
					y: Math.round(rect.top * dpr),
					width: Math.round(rect.width * dpr),
					height: Math.round(rect.height * dpr),
				};
			}

			async function setPreviewEnabled(enabled: boolean) {
				const btn = el<HTMLButtonElement>("toggle-preview")!;
				const placeholder = el("preview-placeholder")!;
				btn.disabled = true;
				try {
					if (enabled) {
						const rect = previewRect();
						await invoke("toggle_preview", { enabled: true, ...rect });
						previewEnabled = true;
						btn.textContent = "Desactivar preview";
						btn.className = "text-xs font-medium text-red-400 bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 rounded px-3 py-1 transition-all cursor-pointer";
						placeholder.classList.add("hidden");
					} else {
						await invoke("toggle_preview", { enabled: false, x: 0, y: 0, width: 0, height: 0 });
						previewEnabled = false;
						btn.textContent = "Activar preview";
						btn.className = "text-xs font-medium text-orange-400 bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/30 rounded px-3 py-1 transition-all cursor-pointer";
						placeholder.classList.remove("hidden");
					}
				} catch (err) {
					setText("overlays-status", `Error: ${err}`);
				} finally {
					btn.disabled = false;
				}
			}

			el("toggle-preview")?.addEventListener("click", () => {
				previewEnabledWanted = !previewEnabledWanted;
				setPreviewEnabled(previewEnabledWanted);
			});

			async function refreshPreviewRectIfEnabled() {
				if (!previewEnabled || activeTab !== "studio") return;
				const rect = previewRect();
				await invoke("update_preview_rect", rect);
			}

			win.listen("tauri://move", () => {
				refreshPreviewRectIfEnabled();
			});

			// Controladores de Zoom y Grid (Eventos de Preview)
			listen("preview-params-changed", (event) => {
				const payload = event.payload as [number, number, number, string];
				const [zoom, _panX, _panY, grid] = payload;
				
				const zoomPct = Math.round(zoom * 100);
				setText("zoom-display", `${zoomPct}%`);
				
				const select = el<HTMLSelectElement>("grid-select");
				if (select && select.value !== grid) {
					select.value = grid;
				}
			});

			el("grid-select")?.addEventListener("change", async (e) => {
				const val = (e.target as HTMLSelectElement).value;
				await invoke("set_preview_grid", { grid: val });
			});

			el("reset-zoom")?.addEventListener("click", async () => {
				await invoke("reset_preview_zoom");
			});

			function overlayLabel(o: OverlayInfo): string {
				if (o.kind === "image") {
					const name = o.content.split(/[\\/]/).pop() ?? o.content;
					return name;
				}
				return o.content || "(vacio)";
			}

			function renderOverlays(overlays: OverlayInfo[]) {
				const container = el("overlays-list")!;
				const template = el<HTMLTemplateElement>("overlay-template")!;
				container.innerHTML = "";

				overlays.forEach((overlay) => {
					const node = template.content.cloneNode(true) as DocumentFragment;
					const itemEl = node.querySelector(".overlay-item") as HTMLElement;
					itemEl.dataset.index = String(overlay.index);

					const badge = node.querySelector(".overlay-kind-badge") as HTMLElement;
					badge.textContent = overlay.kind === "image" ? "IMG" : "TXT";

					const contentEl = node.querySelector(".overlay-content") as HTMLElement;
					contentEl.textContent = overlayLabel(overlay);
					contentEl.title = overlay.content;

					const xInput = node.querySelector(".overlay-x") as HTMLInputElement;
					const yInput = node.querySelector(".overlay-y") as HTMLInputElement;
					const scaleInput = node.querySelector(".overlay-scale") as HTMLInputElement;
					xInput.value = String(Math.round(overlay.x));
					yInput.value = String(Math.round(overlay.y));
					scaleInput.value = String(overlay.scale);

					if (overlay.locked) {
						xInput.disabled = true;
						yInput.disabled = true;
						scaleInput.disabled = true;
						itemEl.classList.add("border-orange-500/20");
					}

					async function pushTransform() {
						const x = Number(xInput.value) || 0;
						const y = Number(yInput.value) || 0;
						const scale = Number(scaleInput.value) || 1;
						await invoke("set_overlay_transform", { index: overlay.index, x, y, scale });
					}
					xInput.addEventListener("change", pushTransform);
					yInput.addEventListener("change", pushTransform);
					scaleInput.addEventListener("change", pushTransform);

					const lockBtn = node.querySelector(".overlay-toggle-lock") as HTMLButtonElement;
					lockBtn.innerHTML = overlay.locked 
						? `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="text-orange-400"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>` // Cerrado
						: `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-500 hover:text-zinc-200"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>`; // Abierto
					
					lockBtn.addEventListener("click", async () => {
						const updated = await invoke<OverlayInfo[]>("set_overlay_locked", { index: overlay.index, locked: !overlay.locked });
						renderOverlays(updated);
					});

					const moveUpBtn = node.querySelector(".overlay-move-up") as HTMLButtonElement;
					const moveDownBtn = node.querySelector(".overlay-move-down") as HTMLButtonElement;

					moveUpBtn.addEventListener("click", async () => {
						try {
							const updated = await invoke<OverlayInfo[]>("reorder_overlay", { index: overlay.index, up: true });
							renderOverlays(updated);
						} catch (err) {
							console.error(err);
						}
					});

					moveDownBtn.addEventListener("click", async () => {
						try {
							const updated = await invoke<OverlayInfo[]>("reorder_overlay", { index: overlay.index, up: false });
							renderOverlays(updated);
						} catch (err) {
							console.error(err);
						}
					});

					const visibleBtn = node.querySelector(".overlay-toggle-visible") as HTMLButtonElement;
					function paintVisible(visible: boolean) {
						visibleBtn.classList.toggle("text-zinc-500", visible);
						visibleBtn.classList.toggle("text-zinc-700", !visible);
						itemEl.classList.toggle("opacity-50", !visible);
					}
					paintVisible(overlay.visible);
					visibleBtn.addEventListener("click", async () => {
						const nowVisible = itemEl.classList.contains("opacity-50");
						await invoke("set_overlay_visible", { index: overlay.index, visible: nowVisible });
						paintVisible(nowVisible);
					});

					const removeBtn = node.querySelector(".overlay-remove") as HTMLButtonElement;
					removeBtn.addEventListener("click", async () => {
						const updated = await invoke<OverlayInfo[]>("remove_overlay", { index: overlay.index });
						renderOverlays(updated);
					});

					container.appendChild(node);
				});
			}

			el("add-image-overlay")?.addEventListener("click", async () => {
				const path = await open({
					multiple: false,
					title: "Elegir imagen para el overlay",
					filters: [{ name: "Imagenes", extensions: ["png", "jpg", "jpeg", "gif", "bmp"] }],
				});
				if (!path) return;
				try {
					const updated = await invoke<OverlayInfo[]>("add_image_overlay", { path });
					renderOverlays(updated);
					setText("overlays-status", "");
					await refreshPreviewRectIfEnabled();
				} catch (err) {
					setText("overlays-status", `Error: ${err}`);
				}
			});

			el("show-add-text-overlay")?.addEventListener("click", () => {
				const form = el("add-text-overlay-form")!;
				const hidden = form.classList.contains("hidden");
				form.classList.toggle("hidden");
				form.classList.toggle("flex", hidden);
				if (hidden) el<HTMLInputElement>("new-overlay-text")?.focus();
			});

			el("confirm-add-text-overlay")?.addEventListener("click", async () => {
				const input = el<HTMLInputElement>("new-overlay-text")!;
				const text = input.value.trim();
				if (!text) return;
				try {
					const updated = await invoke<OverlayInfo[]>("add_text_overlay", { text });
					renderOverlays(updated);
					input.value = "";
					setText("overlays-status", "");
					await refreshPreviewRectIfEnabled();
				} catch (err) {
					setText("overlays-status", `Error: ${err}`);
				}
			});

			// ---------------------------------------------------------------
			// Carga inicial
			// ---------------------------------------------------------------
			async function loadConfig() {
				const config = await invoke<EmberioConfig>("get_config");

				el<HTMLInputElement>("clip-seconds")!.value = String(config.clip_seconds);
				el<HTMLSelectElement>("resolution-select")!.value = config.resolution;
				el<HTMLSelectElement>("fps-select")!.value = String(config.fps);

				setText("clips-dir-display", config.clips_dir ?? "clips/ (por defecto)");

				const hotkeyDesc = describeHotkey(config.hotkey);
				setText("hotkey-kbd", hotkeyDesc);

				renderAudioTracks(config.audio_sources);

				try {
					const overlays = await invoke<OverlayInfo[]>("list_overlays");
					renderOverlays(overlays);
				} catch (err) {
					setText("overlays-status", `Error: ${err}`);
				}

				try {
					// Inicializar selectores de video
					const captureTypeSelect = el<HTMLSelectElement>("capture-type-select")!;
					captureTypeSelect.value = config.video_source_type || "screen";
					
					await updateSourceOptions(captureTypeSelect.value, config.video_source_id);

					const [outputs, inputs] = await Promise.all([
						invoke<PropertyOption[]>("list_audio_output_devices"),
						invoke<PropertyOption[]>("list_audio_input_devices"),
					]);
					audioOutputDevices = outputs;
					audioInputDevices = inputs;
					await refreshNewAudioDeviceOptions();
				} catch (err) {
					setText("audio-sources-status", `No se pudieron listar pantallas/dispositivos: ${err}`);
				}
			}

			loadConfig();
		</script>
	</body>
</html>
