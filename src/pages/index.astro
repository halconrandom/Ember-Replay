<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Emberio</title>
	</head>
	<body>
		<h1>Emberio</h1>

		<section>
			<label for="clip-seconds">Segundos a clipear:</label>
			<input type="number" id="clip-seconds" value="60" min="5" max="1200" />
			<button id="start-recording">Empezar a grabar</button>
			<button id="stop-recording">Detener grabacion</button>
			<p id="recording-status"></p>
		</section>

		<section>
			<button id="save-clip">Guardar clip ahora</button>
			<p id="save-clip-status"></p>
		</section>

		<section>
			<button id="change-hotkey">Cambiar hotkey de guardado (por defecto F9)</button>
			<p id="hotkey-status">Apreta el boton y despues la tecla que quieras usar.</p>
		</section>

		<script>
			import { invoke } from "@tauri-apps/api/core";
			import { listen } from "@tauri-apps/api/event";

			function setText(id: string, text: string) {
				const el = document.getElementById(id);
				if (el) el.textContent = text;
			}

			document.getElementById("start-recording")?.addEventListener("click", async () => {
				const secondsInput = document.getElementById("clip-seconds") as HTMLInputElement;
				const seconds = Number(secondsInput.value) || 60;
				setText("recording-status", "Arrancando...");
				try {
					const status = await invoke<string>("start_recording", { clipSeconds: seconds });
					setText("recording-status", status);
				} catch (err) {
					setText("recording-status", `Error: ${err}`);
				}
			});

			document.getElementById("stop-recording")?.addEventListener("click", async () => {
				setText("recording-status", "Deteniendo...");
				try {
					const status = await invoke<string>("stop_recording");
					setText("recording-status", status);
				} catch (err) {
					setText("recording-status", `Error: ${err}`);
				}
			});

			document.getElementById("save-clip")?.addEventListener("click", async () => {
				setText("save-clip-status", "Guardando...");
				await invoke("save_clip_now");
			});

			listen<string>("clip-saved", (event) => {
				setText("save-clip-status", `Clip guardado: ${event.payload}`);
			});

			listen<string>("clip-save-error", (event) => {
				setText("save-clip-status", `Error al guardar: ${event.payload}`);
			});

			document.getElementById("change-hotkey")?.addEventListener("click", () => {
				setText("hotkey-status", "Apreta la tecla que queres usar...");

				const onKeyDown = async (e: KeyboardEvent) => {
					e.preventDefault();
					window.removeEventListener("keydown", onKeyDown, true);

					try {
						const status = await invoke<string>("set_save_hotkey", {
							vkCode: e.keyCode,
							ctrl: e.ctrlKey,
							shift: e.shiftKey,
							alt: e.altKey,
						});
						setText("hotkey-status", status);
					} catch (err) {
						setText("hotkey-status", `Error: ${err}`);
					}
				};

				window.addEventListener("keydown", onKeyDown, true);
			});
		</script>
	</body>
</html>
