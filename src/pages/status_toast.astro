---
import '../styles/global.css';
---

<html lang="es" class="bg-transparent h-full select-none overflow-hidden">
	<head>
		<meta charset="utf-8" />
		<title>Ember Status Indicator</title>
	</head>
	<body class="bg-transparent m-0 h-full w-full flex items-center justify-center">
		<!-- Small translucent dark square containing the status dot -->
		<div class="w-8 h-8 rounded-lg bg-zinc-950/80 border border-zinc-800/80 shadow-lg flex items-center justify-center backdrop-blur-md">
			<div 
				id="status-dot" 
				class="w-2.5 h-2.5 rounded-full bg-red-500 border border-red-400/40 shadow-[0_0_8px_rgba(239,68,68,0.8)] transition-all duration-500 ease-in-out"
			></div>
		</div>

		<script>
			import { listen } from "@tauri-apps/api/event";

			const dot = document.getElementById("status-dot")!;

			function updateStatus(active: boolean) {
				if (active) {
					dot.className = "w-2.5 h-2.5 rounded-full bg-emerald-500 border border-emerald-400/40 shadow-[0_0_8px_rgba(16,185,129,0.9)] transition-all duration-500 ease-in-out";
				} else {
					dot.className = "w-2.5 h-2.5 rounded-full bg-red-500 border border-red-400/40 shadow-[0_0_8px_rgba(239,68,68,0.9)] transition-all duration-500 ease-in-out";
				}
			}

			// Expuesto para que el backend pueda forzar el estado via eval()
			// aunque el evento no llegue.
			(window as any).__setStatus = updateStatus;

			// Check URL parameter on load
			const params = new URLSearchParams(window.location.search);
			const activeParam = params.get("active");
			if (activeParam !== null) {
				updateStatus(activeParam === "true");
			}

			listen<boolean>("show-status", (event) => {
				updateStatus(event.payload);
			});
		</script>
	</body>
</html>
