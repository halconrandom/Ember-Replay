---
import '../styles/global.css';
---

<html lang="es" class="bg-transparent h-full select-none overflow-hidden">
	<head>
		<meta charset="utf-8" />
		<title>Ember Status</title>
	</head>
	<body class="bg-transparent m-0 h-full w-full flex items-center justify-end pr-4">
		<!-- Tiny Xbox-like Status Pill -->
		<div id="status-pill" class="hidden bg-zinc-950/95 border border-zinc-800/90 rounded-full px-3 py-1.5 flex items-center gap-2 shadow-xl translate-x-[300px] opacity-0 transition-all duration-300 backdrop-blur-md">
			<div id="status-dot" class="w-2 h-2 rounded-full animate-pulse"></div>
			<span id="status-text" class="text-[10px] font-bold text-zinc-200 tracking-wider">Ember</span>
		</div>

		<script>
			import { listen } from "@tauri-apps/api/event";
			import { getCurrentWindow } from "@tauri-apps/api/window";

			const win = getCurrentWindow();
			const pill = document.getElementById("status-pill")!;
			const dot = document.getElementById("status-dot")!;
			const text = document.getElementById("status-text")!;
			let hideTimeout: number;

			function triggerStatus(active: boolean) {
				if (active) {
					dot.className = "w-2 h-2 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_6px_rgba(16,185,129,0.8)]";
					text.textContent = "Grabación Iniciada";
				} else {
					dot.className = "w-2 h-2 rounded-full bg-red-500 animate-pulse shadow-[0_0_6px_rgba(239,68,68,0.8)]";
					text.textContent = "Grabación Detenida";
				}

				clearTimeout(hideTimeout);
				pill.classList.remove("hidden");
				void pill.offsetWidth;

				pill.classList.remove("translate-x-[300px]", "opacity-0");
				pill.classList.add("translate-x-0", "opacity-100");

				hideTimeout = window.setTimeout(() => {
					pill.classList.remove("translate-x-0", "opacity-100");
					pill.classList.add("translate-x-[300px]", "opacity-0");

					setTimeout(() => {
						pill.classList.add("hidden");
						win.hide();
					}, 300);
				}, 3000);
			}

			// Verificar parametros de carga
			const params = new URLSearchParams(window.location.search);
			const activeParam = params.get("active");
			if (activeParam !== null) {
				triggerStatus(activeParam === "true");
			}

			listen<boolean>("show-status", (event) => {
				triggerStatus(event.payload);
			});
		</script>
	</body>
</html>
